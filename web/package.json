{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "prebuild": "node scripts/build-worker.mjs",
    "predev": "node scripts/build-worker.mjs",
    "typecheck": "tsc --noEmit",
    "e2e:smoke": "node scripts/e2e-smoke.mjs",
    "test:rls": "node scripts/supabase/rls-check.mjs",
    "test:checkin": "node --disable-warning=ExperimentalWarning --test --test-reporter=spec ../supabase/functions/tests/checkin.test.ts",
    "email:preview": "node --disable-warning=ExperimentalWarning scripts/email/checkin-preview.mjs",
    "test:sync": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/test-hooks.mjs --test --test-reporter=spec \"lib/sync/tests/*.test.ts\"",
    "test:budget": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/test-hooks.mjs --test --test-reporter=spec \"tools/budget/tests/*.test.ts\"",
    "test:tax": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/test-hooks.mjs --test --test-reporter=spec \"tools/tax/tests/*.test.ts\"",
    "test:plan": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/test-hooks.mjs --test --test-reporter=spec \"tools/plan/tests/*.test.ts\"",
    "test:guide": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/test-hooks.mjs --test --test-reporter=spec \"tools/guide/tests/*.test.ts\"",
    "test:advanced": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/test-hooks.mjs --test --test-reporter=spec \"tools/advanced/tests/*.test.ts\"",
    "test:dashboard": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/test-hooks.mjs --test --test-reporter=spec \"components/dashboard/tests/*.test.ts\""
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@sentry/nextjs": "11.5.0",
    "@supabase/supabase-js": "2.117.3",
    "@vercel/analytics": "2.0.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@playwright/test": "^1.63.0",
    "@shadcn/lint": "^0.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "postcss": "^8.5.29",
    "supabase": "2.120.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
