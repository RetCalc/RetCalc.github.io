# Accounts (ACCOUNTS_PLAN.md). Without these the site runs exactly as
# before: no sign-in, everything saved in the browser only.
# Both are public by design (sent to the browser). Never put the secret key
# in a NEXT_PUBLIC_ variable; it lives only in Supabase's Edge Functions.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Google's sign-in button (components/account/GoogleButton.tsx): the OAuth
# client ID from Google Cloud (public; it ends in .apps.googleusercontent.com).
# Without it, "Continue with Google" uses the redirect sign-in instead.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=...apps.googleusercontent.com
