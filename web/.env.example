# Accounts (ACCOUNTS_PLAN.md). Without these the site runs exactly as
# before: no sign-in, everything saved in the browser only.
# Both are public by design (sent to the browser). Never put the secret key
# in a NEXT_PUBLIC_ variable; it lives only in Supabase's Edge Functions.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
